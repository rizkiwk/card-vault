# Copy this file to `android/key.properties` and fill in your real values.
# DO NOT commit the filled-in key.properties or the .jks keystore.
#
# 1. Create an upload keystore (valid 27+ years, RSA 2048):
#    keytool -genkey -v -keystore ~/cardvault-upload.jks \
#      -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# 2. Point storeFile at that file (absolute path or relative to android/app).

storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=upload
storeFile=/absolute/path/to/cardvault-upload.jks
